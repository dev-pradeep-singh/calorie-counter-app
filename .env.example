# Copy to .env for local dev (uvicorn reads it). On Vercel, set these as env vars.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase anon / publishable key>
ANTHROPIC_API_KEY=<anthropic api key>
# Optional: Claude model for food analysis (default claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
# Only if the Supabase project still signs tokens with the legacy HS256 JWT secret:
# SUPABASE_JWT_SECRET=
