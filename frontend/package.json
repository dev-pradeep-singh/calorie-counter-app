{
  "name": "calzy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "gen:api": "cd .. && .venv/bin/python -c \"import json; from backend.main import app; print(json.dumps(app.openapi()))\" > frontend/openapi.json && cd frontend && openapi-typescript openapi.json -o src/lib/api-types.ts && rm openapi.json"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
